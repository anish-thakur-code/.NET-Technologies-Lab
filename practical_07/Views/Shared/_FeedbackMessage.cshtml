

@if (TempData["SuccessMessage"] != null)
{
    <div class="success-message">
        @TempData["SuccessMessage"]
    </div>
}

<style>
    .success-message {
        background-color: #d1fae5;
        color: #065f46;
        border: 1px solid #6ee7b7;
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-weight: bold;
    }
</style>
