@model IEnumerable<practical_06_.NET.Models.Product>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Product Catalog</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #667eea, #764ba2);
            min-height: 100vh;
            padding: 50px 20px;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: auto;
            background: white;
            padding: 35px;
            border-radius: 18px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

            .header h1 {
                margin: 0;
                color: #333;
                font-size: 36px;
            }

            .header p {
                color: #777;
                margin-top: 8px;
                font-size: 16px;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            overflow: hidden;
            border-radius: 12px;
        }

        th {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 16px;
            font-size: 16px;
            text-align: center;
        }

        td {
            padding: 15px;
            text-align: center;
            border-bottom: 1px solid #eee;
            color: #444;
            font-size: 15px;
        }

        tbody tr:nth-child(even) {
            background-color: #f7f7ff;
        }

        tbody tr:hover {
            background-color: #e9e7ff;
            transform: scale(1.01);
            transition: 0.2s;
        }

        .price {
            color: #198754;
            font-weight: bold;
        }

        .category {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            background-color: #eee8ff;
            color: #6741d9;
            font-weight: bold;
            font-size: 13px;
        }

        .footer {
            text-align: center;
            margin-top: 25px;
            color: #888;
            font-size: 14px;
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <h1>🛍️ Product Catalog</h1>
            <p>Explore our collection of products</p>
        </div>

        <table>

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Category</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>

                        <td>
                            <strong>@product.Name</strong>
                        </td>

                        <td class="price">
                            ₹@product.Price
                        </td>

                        <td>
                            <span class="category">
                                @product.Category
                            </span>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

        <div class="footer">
            ASP.NET MVC Product Catalog
        </div>

    </div>

</body>
</html>